---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found · SWRSWR"
  description="The page you were looking for does not exist."
>
  <section class="nf section">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1>We couldn't find that page.</h1>
      <p class="muted">
        The link may be out of date, or the page may have been moved. Here are
        a few good places to go next:
      </p>
      <ul class="nf__links">
        <li><a href="/">Home</a></li>
        <li><a href="/#services">Services</a></li>
        <li><a href="/#cases">Case studies</a></li>
        <li><a href="/#contact">Contact us</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: 6rem;
  }
  .nf__links {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    font-weight: 600;
  }
</style>
