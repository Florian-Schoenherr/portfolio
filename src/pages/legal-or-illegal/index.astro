---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AiScenarioCard from '../../components/AiScenarioCard.astro';
import { withBase } from '../../utils/url';

const scenarios = (await getCollection('aiScenarios')).sort(
  (a, b) => a.data.order - b.data.order
);

const rendered = await Promise.all(
  scenarios.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);
---

<BaseLayout
  title="Legal or Illegal? · SWRSWR"
  description="Three real-world-style examples of generative AI use in academic settings. Can you tell which is red, yellow, and green?"
  current="Insights"
>
  <section class="section">
    <div class="container loi" id="ai-vote-root">
      <header class="loi__head">
        <p class="eyebrow">AI in academia · Traffic light model</p>
        <h1>Legal or Illegal?</h1>
        <p class="muted loi__lede">
          Below are three examples of how generative AI might show up in
          university work. Each one is realistic — but we have <em>not</em>
          labelled them. Vote <strong>red</strong>, <strong>yellow</strong>,
          or <strong>green</strong> on each card — it tints immediately to
          show how you classified it. Our opinion appears after you vote.
        </p>
      </header>

      <p class="loi__status" data-vote-status aria-live="polite"></p>

      <aside class="loi__legend" aria-label="Traffic light model key">
        <p class="loi__legend-title">The model</p>
        <ul class="loi__lights">
          <li>
            <span class="loi__dot loi__dot--red" aria-hidden="true"></span>
            <span><strong>Red</strong> — clear misconduct or prohibited use</span>
          </li>
          <li>
            <span class="loi__dot loi__dot--yellow" aria-hidden="true"></span>
            <span><strong>Yellow</strong> — ambiguous policy or questionable judgement</span>
          </li>
          <li>
            <span class="loi__dot loi__dot--green" aria-hidden="true"></span>
            <span><strong>Green</strong> — permitted use, properly bounded or declared</span>
          </li>
        </ul>
      </aside>

      <div class="loi__grid">
        {
          rendered.map(({ entry, Content }, i) => (
            <AiScenarioCard
              index={i + 1}
              slug={entry.id}
              title={entry.data.title}
              context={entry.data.context}
              classification={entry.data.classification}
            >
              <Content />
            </AiScenarioCard>
          ))
        }
      </div>

      <p class="loi__note muted">
        These are illustrative scenarios for discussion — not legal advice.
        Actual rules depend on your institution, module handbook, and exam
        conditions. When in doubt, ask before you submit.
      </p>

      <p class="loi__back">
        <a href={withBase('/insights/')}>← Back to insights</a>
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  import { initAiVoting } from '../../scripts/ai-voting.ts';
  initAiVoting();
</script>

<style>
  .loi {
    max-width: 960px;
  }

  .loi__head {
    margin-bottom: 1.25rem;
  }

  .loi__lede {
    font-size: 1.05rem;
    max-width: 62ch;
    margin: 0.75rem 0 0;
  }

  .loi__status {
    margin: 0 0 1.5rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.9rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-muted);
  }

  .loi__legend {
    margin-bottom: 2rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .loi__legend-title {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }

  .loi__lights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .loi__lights li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.95rem;
    color: var(--color-fg);
  }

  .loi__dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    flex: 0 0 auto;
  }

  .loi__dot--red {
    background: #ef4444;
  }

  .loi__dot--yellow {
    background: #f59e0b;
  }

  .loi__dot--green {
    background: #10b981;
  }

  .loi__grid {
    display: grid;
    gap: 1.25rem;
  }

  .loi__note {
    margin: 2rem 0 0;
    font-size: 0.88rem;
    max-width: 62ch;
  }

  .loi__back {
    margin: 1.5rem 0 0;
    font-size: 0.9rem;
  }
</style>
