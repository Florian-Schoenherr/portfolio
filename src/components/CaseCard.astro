---
interface Metric {
  label: string;
  value: string;
}

interface Props {
  title: string;
  client: string;
  industry: string;
  summary: string;
  href: string;
  metrics: Metric[];
  stack: string[];
}

const { title, client, industry, summary, href, metrics, stack } = Astro.props;
---

<article class="cc">
  <header class="cc__head">
    <p class="cc__eyebrow">
      <span>{client}</span>
      <span aria-hidden="true">·</span>
      <span>{industry}</span>
    </p>
    <h3 class="cc__title">
      <a href={href}>{title}</a>
    </h3>
  </header>

  <p class="cc__summary">{summary}</p>

  <dl class="cc__metrics" aria-label="Outcomes">
    {
      metrics.slice(0, 3).map((m) => (
        <div>
          <dt>{m.label}</dt>
          <dd>{m.value}</dd>
        </div>
      ))
    }
  </dl>

  <ul class="cc__stack" aria-label="Stack">
    {stack.slice(0, 5).map((s) => <li>{s}</li>)}
  </ul>

  <a class="cc__cta" href={href}>
    Read the case study
    <span aria-hidden="true">→</span>
  </a>
</article>

<style>
  .cc {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    box-shadow: var(--shadow-sm);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    height: 100%;
  }

  .cc:hover {
    border-color: color-mix(in srgb, var(--color-accent) 40%, var(--color-border));
    box-shadow: var(--shadow-md);
  }

  .cc__eyebrow {
    display: inline-flex;
    gap: 0.5rem;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin: 0 0 0.5rem;
  }

  .cc__title {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .cc__title a {
    color: var(--color-fg);
    text-decoration: none;
  }

  .cc__title a:hover {
    color: var(--color-accent);
  }

  .cc__summary {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.97rem;
  }

  .cc__metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    padding: 1rem;
    margin: 0;
    background: var(--color-surface);
    border-radius: var(--radius-md);
  }

  .cc__metrics dt {
    margin: 0;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    font-weight: 600;
  }

  .cc__metrics dd {
    margin: 0.15rem 0 0;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .cc__stack {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .cc__stack li {
    font-size: 0.78rem;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-muted);
    border: 1px solid var(--color-border);
  }

  .cc__cta {
    margin-top: auto;
    font-weight: 600;
    font-size: 0.93rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  @media (max-width: 520px) {
    .cc__metrics {
      grid-template-columns: 1fr;
    }
  }
</style>
