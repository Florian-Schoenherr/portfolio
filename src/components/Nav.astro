---
import Logo from './Logo.astro';
import { withBase } from '../utils/url';

interface Props {
  current?: string;
}

const { current } = Astro.props;

const links = [
  { href: withBase('/#services'), label: 'Services' },
  { href: withBase('/#team'), label: 'Team' },
  { href: withBase('/#cases'), label: 'Case Studies' },
  { href: withBase('/insights/'), label: 'Insights' },
  { href: withBase('/#contact'), label: 'Contact' },
];
---

<header class="nav">
  <div class="container nav__inner">
    <a href={withBase('/')} class="nav__brand" aria-label="SWRSWR — home">
      <Logo size={32} />
      <span class="nav__wordmark">
        <span class="nav__initials">SWRSWR</span>
        <span class="nav__full">SchönherrWeberReichert · SoftWareResearch</span>
      </span>
    </a>

    <nav aria-label="Primary">
      <ul class="nav__list">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={['nav__link', current === link.label ? 'is-current' : '']}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    -webkit-backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.9rem;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--color-fg);
    font-weight: 600;
    text-decoration: none;
  }

  .nav__brand:hover {
    text-decoration: none;
    color: var(--color-fg);
  }

  .nav__wordmark {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .nav__initials {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    letter-spacing: 0.04em;
  }

  .nav__full {
    font-size: 0.7rem;
    color: var(--color-muted);
    letter-spacing: 0.02em;
  }

  .nav__list {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-muted);
    text-decoration: none;
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .nav__link:hover,
  .nav__link.is-current {
    color: var(--color-fg);
    text-decoration: none;
    border-bottom-color: var(--color-accent);
  }

  @media (max-width: 720px) {
    .nav__full {
      display: none;
    }

    .nav__list {
      gap: 1rem;
    }

    .nav__link {
      font-size: 0.85rem;
    }
  }

  @media (max-width: 520px) {
    .nav__wordmark {
      display: none;
    }
  }
</style>
