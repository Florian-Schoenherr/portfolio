---
import BaseLayout from './BaseLayout.astro';
import AuthorByline from '../components/AuthorByline.astro';
import { withBase } from '../utils/url';

interface Props {
  title: string;
  summary: string;
  date: Date;
  author: 'schoenherr' | 'weber' | 'reichert';
  category: 'opinion' | 'guide';
  tags?: string[];
}

const { title, summary, date, author, category, tags = [] } = Astro.props;
const pageTitle = `${title} · SWRSWR Insights`;
const categoryLabel = category === 'guide' ? 'Field guide' : 'Opinion';
---

<BaseLayout title={pageTitle} description={summary} current="Insights">
  <article class="post">
    <div class="container post__inner">
      <nav class="post__crumbs" aria-label="Breadcrumb">
        <a href={withBase('/insights/')}>← All insights</a>
      </nav>

      <header class="post__head">
        <p class="eyebrow">{categoryLabel}</p>
        <h1>{title}</h1>
        <p class="post__lede">{summary}</p>
        <AuthorByline authorSlug={author} date={date} />
        {
          tags.length > 0 && (
            <ul class="post__tags" aria-label="Tags">
              {tags.map((t) => <li>#{t}</li>)}
            </ul>
          )
        }
      </header>

      <div class="post__body">
        <slot />
      </div>

      <footer class="post__foot">
        <a class="button button--primary" href={withBase('/#contact')}>
          Disagree? Tell us why.
        </a>
        <a class="button button--secondary" href={withBase('/insights/')}>
          More insights
        </a>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding-block: clamp(2rem, 5vw, 4rem) 5rem;
  }

  .post__inner {
    max-width: 760px;
  }

  .post__crumbs {
    margin-bottom: 2rem;
    font-size: 0.9rem;
  }

  .post__head {
    padding-bottom: 2rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .post__head h1 {
    margin: 0.25rem 0 1rem;
  }

  .post__lede {
    font-size: 1.15rem;
    color: var(--color-muted);
    margin-bottom: 1.5rem;
  }

  .post__tags {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .post__tags li {
    font-size: 0.78rem;
    color: var(--color-muted);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .post__body :global(p) {
    font-size: 1.05rem;
    line-height: 1.75;
    margin: 0 0 1.1em;
    color: var(--color-fg);
  }

  .post__body :global(p:first-of-type::first-letter) {
    font-family: var(--font-serif);
    font-size: 3em;
    line-height: 0.9;
    float: left;
    padding: 0.05em 0.1em 0 0;
    color: var(--color-accent);
  }

  .post__body :global(h2) {
    margin-top: 2.5rem;
    font-size: 1.4rem;
  }

  .post__body :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.5rem 0 0.5rem 1.25rem;
    border-left: 3px solid var(--color-accent);
    color: var(--color-muted);
    font-family: var(--font-serif);
    font-style: italic;
  }

  .post__body :global(strong) {
    color: var(--color-fg);
    font-weight: 700;
  }

  .post__foot {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
</style>
