---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/url';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  current?: string;
}

const {
  title = 'SWRSWR — Research-grade software. Boardroom-grade delivery.',
  description = 'SWRSWR (SchönherrWeberReichert SoftWareResearch) is a modern IT consultancy specialising in process automation and the digitalization of paper-era workflows for mid-market European firms.',
  ogImage = withBase('/og-image.svg'),
  current,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://swrswr.example.com').toString();
const faviconHref = withBase('/favicon.svg');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="SWRSWR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#2563eb" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
