---
import BaseLayout from './BaseLayout.astro';
import PosterFrame from '../components/PosterFrame.astro';
import AuthorByline from '../components/AuthorByline.astro';
import { withBase } from '../utils/url';

interface Props {
  title: string;
  summary: string;
  date: Date;
  author: 'schoenherr' | 'weber' | 'reichert';
  downloadHref?: string;
}

const { title, summary, date, author, downloadHref } = Astro.props;
const pageTitle = `${title} · SWRSWR field guide`;
---

<BaseLayout title={pageTitle} description={summary} current="Insights">
  <div class="container poster-wrap">
    <nav class="poster-wrap__crumbs" aria-label="Breadcrumb">
      <a href={withBase('/insights/')}>← All insights</a>
    </nav>

    <PosterFrame
      title={title}
      subtitle={summary}
      downloadHref={downloadHref}
    >
      <slot />
    </PosterFrame>

    <div class="poster-wrap__byline">
      <AuthorByline authorSlug={author} date={date} size="sm" />
    </div>
  </div>
</BaseLayout>

<style>
  .poster-wrap {
    padding-block: clamp(2rem, 5vw, 4rem) 5rem;
  }

  .poster-wrap__crumbs {
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .poster-wrap__byline {
    max-width: 1100px;
    margin: 1.5rem auto 0;
    display: flex;
    justify-content: flex-end;
  }

  @media print {
    .poster-wrap__crumbs,
    .poster-wrap__byline {
      display: none;
    }
  }
</style>
